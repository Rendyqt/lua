-- Setup animation
local function loadWalkAnimation()
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    local animation = Instance.new("Animation")
    animation.Name = "AutoWalkAnim"
    animation.AnimationId = ANIMATION_ID
    animTrack = animator:LoadAnimation(animation)
    animTrack.Priority = Enum.AnimationPriority.Movement
end

-- Recording logic
local function startRecording()
    if recording then return end
    recording = true
    recordedPoints = {}
    -- sample
    recordConnection = RunService.Heartbeat:Connect(function(dt)
        -- use a simple timer
        local elapsed = 0
        elapsed = elapsed + dt -- local var resets each frame; we need closure-based timer
    end)

    -- Because Heartbeat callback with closure timer is messy, use a coroutine-based loop
    coroutine.wrap(function()
        while recording do
            if hrp then
                table.insert(recordedPoints, hrp.CFrame)
            end
            wait(RECORD_INTERVAL)
        end
    end)()
end

local function stopRecording()
    recording = false
    if recordConnection then
        recordConnection:Disconnect()
        recordConnection = nil
    end
end

-- Play (auto-walk) logic: use TweenService to move HRP across points
local function playRecorded()
    if #recordedPoints < 2 then
        warn("Tidak ada cukup titik rekaman untuk diputar")
        return
    end

    -- disable default humanoid auto-walk while tweening
    local oldWalkSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = WALK_SPEED

    -- play animation if ada
    if animTrack then
        animTrack:Play()
    end

    -- sequentially tween between points
    for i = 1, #recordedPoints do
        local targetCFrame = recordedPoints[i]
        if not hrp or not hrp.Parent then break end
        -- compute distance from current position
        local startPos = hrp.Position
        local endPos = targetCFrame.Position
        local dist = (endPos - startPos).Magnitude
        local speed = math.max(6, WALK_SPEED) -- minimal speed
        local travelTime = dist / speed
        -- create tween for CFrame
        local tweenInfo = TweenInfo.new(math.max(0.05, travelTime), Enum.EasingStyle.Linear)
        local success, err = pcall(function()
            local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
            tween:Play()
            tween.Completed:Wait()
        end)
        if not success then
            warn("Tween error:", err)
            break
        end
    end

    -- stop animation
    if animTrack then
        animTrack:Stop()
    end
    humanoid.WalkSpeed = oldWalkSpeed
end

-- Utility: serialize recordedPoints to a simple string (x,y,z|x,y,z|...)
local function serializePoints()
    local parts = {}
    for _,cf in ipairs(recordedPoints) do
        local p = cf.p
        table.insert(parts, string.format("%.3f,%.3f,%.3f", p.X, p.Y, p.Z))
    end
    return table.concat(parts, "|")
end

local function deserializePoints(s)
    local points = {}
    for token in string.gmatch(s, "([^|]+)") do
        local x,y,z = token:match("([-0-9%.]+),([-0-9%.]+),([-0-9%.]+)")
        if x and y and z then
            local v = Vector3.new(tonumber(x), tonumber(y), tonumber(z))
            table.insert(points, CFrame.new(v))
        end
    end
    return points
end

-- Main
setupCharacter()
local gui = createGui()
loadWalkAnimation()

-- Button events
gui.RecordBtn.MouseButton1Click:Connect(function()
    if recording then return end
    -- clear existing
    recordedPoints = {}
    startRecording()
    gui.RecordBtn.Text = "Recording..."
end)

gui.StopBtn.MouseButton1Click:Connect(function()
    if not recording then return end
    stopRecording()
    gui.RecordBtn.Text = "Record"
    -- update data box
    gui.DataBox.Text = serializePoints()
end)

gui.PlayBtn.MouseButton1Click:Connect(function()
    if recording then
        warn("Berhenti merekam dulu sebelum memutar rekaman")
        return
    end
    -- if data box has content, try parse it (user mungkin paste)
    if gui.DataBox.Text ~= "" then
        local parsed = deserializePoints(gui.DataBox.Text)
        if #parsed > 1 then
            recordedPoints = parsed
        end
    end
    -- run playback in coroutine
    coroutine.wrap(function()
        playRecorded()
    end)()
end)

gui.ClearBtn.MouseButton1Click:Connect(function()
    stopRecording()
    recordedPoints = {}
    gui.DataBox.Text = ""
    gui.RecordBtn.Text = "Record"
end)

gui.ShowBtn.MouseButton1Click:Connect(function()
    gui.DataBox.Text = serializePoints()
end)

-- Auto-reconnect character on respawn
player.CharacterAdded:Connect(function(char)
    character = char
    hrp = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    loadWalkAnimation()
end)

