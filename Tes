-- AutoWalkRecorder.lua
-- Script: Auto-walk + recorder + walking animation
-- Tempatkan sebagai LocalScript di StarterPlayerScripts atau StarterGui (LocalScript)
-- Cara pakai singkat:
-- 1) Masukkan script ini ke dalam StarterPlayer > StarterPlayerScripts atau sebagai LocalScript di StarterGui.
-- 2) Saat bermain, akan muncul sebuah kotak (GUI) di layar dengan tombol: Record, Stop, Play, Clear, Show Data.
-- 3) Tekan Record untuk mulai merekam posisi karakter (sampling setiap 0.2 detik).
-- 4) Tekan Stop untuk berhenti merekam.
-- 5) Tekan Play untuk auto-walk mengikuti rekaman.
-- 6) Tekan Clear untuk menghapus rekaman.
-- 7) Tekan Show Data untuk melihat / copy string rekaman (bisa disalin manual dari Output atau TextBox yang muncul).
-- Catatan: Script ini menggunakan TweenService untuk perpindahan halus dan Humanoid:LoadAnimation untuk animasi jalan.
-- Ganti ANIMATION_ID jika ingin pakai animasi lain.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = nil
local hrp = nil
local humanoid = nil

local RECORD_INTERVAL = 0.2 -- detik, frekuensi sampling saat merekam
local WALK_SPEED = 16 -- kecepatan humanoid saat berjalan saat memutar animasi
local ANIMATION_ID = "rbxassetid://180436334" -- default run/walk animation (ganti jika perlu)

-- State
local recording = false
local recordedPoints = {} -- array of {CFrame}
local recordConnection = nil
local animTrack = nil

-- Utility: Ensure character
local function setupCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    hrp = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
end

